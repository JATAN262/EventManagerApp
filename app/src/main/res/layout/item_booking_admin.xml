<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:layout_marginBottom="8dp">

    <TextView android:id="@+id/clientId" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/organizerId" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/bookingDate" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/occasion" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/acceptBtn" android:layout_width="wrap_content" android:text="Accept" android:layout_height="wrap_content"/>
        <Button android:id="@+id/rejectBtn" android:layout_width="wrap_content" android:text="Reject" android:layout_height="wrap_content"/>
        <Button android:id="@+id/deleteBtn" android:layout_width="wrap_content" android:text="Delete" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
